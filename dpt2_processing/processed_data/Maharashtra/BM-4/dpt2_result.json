      "markdown": "<a id='2bedf4b9-36bd-4adc-a87e-c1c4e236eb1f'></a>\n\n<table id=\"0-1\">\n<tr><td id=\"0-2\">अ.क्र.</td><td id=\"0-3\" colspan=\"2\">तपशील</td><td id=\"0-4\">सविस्तर माहिती</td></tr>\n<tr><td id=\"0-5\">१</td><td id=\"0-6\" colspan=\"2\">पीक/वाणाचे नाव</td><td id=\"0-7\">मूग : बीएम-४</td></tr>\n<tr><td id=\"0-8\">२</td><td id=\"0-9\" colspan=\"2\">प्रसारित केल्याचे वर्ष</td><td id=\"0-a\">१९९४</td></tr>\n<tr><td id=\"0-b\">३</td><td id=\"0-c\" colspan=\"2\">प्रसारीत करणारी संस्था/विद्यापीठ</td><td id=\"0-d\">मराठवाडा कृषि विद्यापीठ, परभणी</td></tr>\n<tr><td id=\"0-e\">४</td><td id=\"0-f\" colspan=\"2\">जमीन</td><td id=\"0-g\">जमिनीचा ६.५० ते ७.५० सामू, योग्य निच-याची मध्यम ते भारी जमीन</td></tr>\n<tr><td id=\"0-h\">५</td><td id=\"0-i\" colspan=\"2\">हवामान</td><td id=\"0-j\">मूग पिकांस २१ ते २४ अंश सें. तापमान आवश्यक, ढगाळ वातावरण हानीकारक</td></tr>\n<tr><td id=\"0-k\">६</td><td id=\"0-l\" colspan=\"2\">पेरणी/लागवडीचा कालावधी</td><td id=\"0-m\">जूनच्या शेवटचा ते जुलैचा पहीला आठवडा</td></tr>\n<tr><td id=\"0-n\">७</td><td id=\"0-o\" colspan=\"2\">प्रती एकर बियाणे</td><td id=\"0-p\">६ किलो</td></tr>\n<tr><td id=\"0-q\" rowspan=\"6\">scribble mark</td><td id=\"0-r\" colspan=\"3\"></td></tr>\n<tr><td id=\"0-s\">१</td><td id=\"0-t\">लागवडीचे/पेरणीचे व्यवस्थापन</td><td id=\"0-u\">हेक्टरी रोपांची संख्या योग्य राखण्याकरीता दोन ओळीतील अंतर ३० तर दोन रोपातील अंतर १० सें.मी. असावे.</td></tr>\n<tr><td id=\"0-v\">२</td><td id=\"0-w\">खत व्यवस्थापन</td><td id=\"0-x\">पेरणीच्या वेळी २५ किलो नत्र व ५० किलो स्फुरद हेक्टरी द्यावे.</td></tr>\n<tr><td id=\"0-y\">३</td><td id=\"0-z\">पाणी व्यवस्थापन</td><td id=\"0-A\">या पिकास पाण्याचा ताण पडल्यास फुलोरा अवस्थेत आणि शेंगा लागण्याच्या अवस्थेत पाणी द्यावे.</td></tr>\n<tr><td id=\"0-B\">४</td><td id=\"0-C\">कीड व्यवस्थापन</td><td id=\"0-D\">शेंगा पोखरणा-या अळीचा बंदोबस्त करण्याकरीता क्लोरपायरीफॉस २० ईसी २० मि.ली./दहा लीटर पाणी या कीड नाशकाची फवारणी करावी. मावा किडीच्या नियंत्रणाकरीता डायमिथोएट ३० इ.सी १५ मि.ली./दहा लीटर पाण्यामध्ये मिसळून फवारावे.</td></tr>\n<tr><td id=\"0-E\">५</td><td id=\"0-F\">रोग व्यवस्थापन</td><td id=\"0-G\">भुरी रोगाच्या नियंत्रणा करीता सल्फेक्स ०.३० टक्के किंवा २०-२२ ग्रॅम पाण्यात विरघळणारे गंधक १० लीटर पाण्यात मिसळून फवारावे. तसेच ३०० पोताची गंधकाची भुकटी २० किलो प्रती हेक्टरी धुरळणी करावी.</td></tr>\n<tr><td id=\"0-H\">९</td><td id=\"0-I\" colspan=\"2\">पिकाचा कालावधी</td><td id=\"0-J\">६५ ते ७० दिवस</td></tr>\n<tr><td id=\"0-K\">१०</td><td id=\"0-L\" colspan=\"2\">उत्पादकता</td><td id=\"0-M\">९-११ क्विंटल प्रती हेक्टरी</td></tr>\n<tr><td id=\"0-N\">११</td><td id=\"0-O\" colspan=\"2\">वाणीची वैशिष्ट्ये/विशेष गुणधर्म</td><td id=\"0-P\">१. भुरी रोगास प्रतीकारक, दाणे मध्यम आकाराचे २. शेंगावर थोड्या प्रमाणात लव असते ३. मध्य भारतासाठी शिफारस</td></tr>\n<tr><td id=\"0-Q\">१२</td><td id=\"0-R\" colspan=\"2\">वाणासंबंधीचे छायाचित्रे</td><td id=\"0-S\">Mungbean BM 4 (image)</td></tr>\n</table>",
