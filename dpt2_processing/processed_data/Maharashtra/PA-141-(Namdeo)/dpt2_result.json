      "markdown": "<a id='b6c4bec7-a48f-4368-a133-c2872a33f6b7'></a>\n\n<table id=\"1-1\">\n<tr><td id=\"1-2\" rowspan=\"3\"></td><td id=\"1-3\"></td><td id=\"1-4\"></td><td id=\"1-5\" colspan=\"3\">दोन पाळ्या द्याव्यात.</td></tr>\n<tr><td id=\"1-6\" rowspan=\"4\">gamma symbol</td><td id=\"1-7\" rowspan=\"3\">कीड व्यवस्थापन</td><td id=\"1-8\">कीड</td><td id=\"1-9\">कीटकनाशक</td><td id=\"1-a\">प्रमाण / प्रती १० लीटर पाणी</td></tr>\n<tr><td id=\"1-b\">मावा, तुडतुडे व फुलकिडे</td><td id=\"1-c\">डायमेथोएट ३० ईसी मिथील डिमेटॉन २५ ईसी अॅसिटामीश्रीड २० एसपी इमिडाक्लोप्रीड १७.८ एसएल थायोमिथाक्झाम २५ डब्ल्युजी फिप्रोनील ५ एससी</td><td id=\"1-d\">१० मिली ८ मिली २ ग्रॅम ४ मिली ३ ग्रॅम २० मिली</td></tr>\n<tr><td id=\"1-e\"></td><td id=\"1-f\">पांढरी माशी</td><td id=\"1-g\">ट्रायझोफॉस ४० ईसी ड्रायफेन्थुरॉन ५० डब्ल्यु पी</td><td id=\"1-h\">२० मिली ८ ग्रॅम</td></tr>\n<tr><td id=\"1-i\"></td><td id=\"1-j\"></td><td id=\"1-k\">पिठया ढेकूण</td><td id=\"1-l\">क्लोरोपायरीफॉस २० ईसी अॅसिफेट ७५ एसपी (कीटकनाशकात २० ग्रॅम धुण्याची पावडर मिसळावी क्विनॉलफॉस २५ ईसी</td><td id=\"1-m\">३० मिली २० मिली २० मिली</td></tr>\n<tr><td id=\"1-n\" rowspan=\"3\"></td><td id=\"1-o\"></td><td id=\"1-p\"></td><td id=\"1-q\">बोंड अळी</td><td id=\"1-r\">थायोडीकार्ब ७५ डब्ल्यू पी स्पिनोसॅड ४५एससी</td><td id=\"1-s\">२० ग्रॅम ४ मिली (text in a box)</td></tr>\n<tr><td id=\"1-t\">५</td><td id=\"1-u\">रोग व्यवस्थापन</td><td id=\"1-v\" colspan=\"3\">दहिया हा रोग कपाशीवर येतो. ऑगस्ट महिन्यात सुरुवातीपासून हा रोग आढळतो. या रोगाचे लक्षण म्हणजे प्रथम झाडाच्या जुन्या पानावर खालच्या बाजूस पांढ-या रंगाचे पट्टे दिसून येतात. रोग व्यवस्थापन उपाय करपा सिडोमोनास फ्लुरोसन्सची बीजप्रक्रिया १० ग्रॅम (पानावरील / कि.ग्रॅ. या प्रमाणात करावी. ठिपके ) पी.एफ.-१ द्रावणाची ०.२ टक्के तीव्रतेची किंवा कॉपर ऑक्सी क्लोराई २५ ग्रॅम / १० लीटर पाणी या प्रमाणात ३०,६० व ९० दिवसांनी फवारणी करावी.</td></tr>\n<tr><td id=\"1-w\"></td><td id=\"1-x\"></td><td id=\"1-y\">दहिया</td><td id=\"1-z\" colspan=\"2\">बावीस्टीन १० ग्रॅम किंवा ८० टक्के गंधक २५ ग्रॅम / १० लीटर पाणी या प्रमाणात ३०, ६० व ९० दिवसांनी फवावरणी करावी.</td></tr>\n<tr><td id=\"1-A\">९</td><td id=\"1-B\" colspan=\"2\">पिकाचा कालावधी</td><td id=\"1-C\" colspan=\"3\">१६० ते १७० दिवस</td></tr>\n<tr><td id=\"1-D\">१०</td><td id=\"1-E\" colspan=\"2\">उत्पादकता</td><td id=\"1-F\" colspan=\"3\">१४ ते १५ क्विं. प्रती हेक्टर</td></tr>\n<tr><td id=\"1-G\">११</td><td id=\"1-H\" colspan=\"2\">वाणाची वैशिष्ट्ये/विशेष गुणधर्म</td><td id=\"1-I\" colspan=\"3\">१. अधिक उत्पादकता २. पाण्याचा ताण सहन करण्याची क्षमता ३. सरस धाग्याचे गुणधर्म</td></tr>\n<tr><td id=\"1-J\">१२</td><td id=\"1-K\" colspan=\"2\">वाणासंबंधीचे छायाचित्रे</td><td id=\"1-L\" colspan=\"3\">field of white flowers</td></tr>\n</table>",
